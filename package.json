{
  "name": "devquest-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "prepare": "husky",
    "e2e": "NEXT_DIST_DIR=.next-e2e next build && playwright test",
    "assets": "tsx scripts/build-assets.ts",
    "seed:content": "node --env-file-if-exists=.env.local --import tsx scripts/seed-content.mts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "grant-role": "node --env-file-if-exists=.env.local --import tsx scripts/grant-role.mts",
    "seed:download": "node --env-file-if-exists=.env.local --import tsx scripts/seed/00-download.mts",
    "seed:vocab": "node --env-file-if-exists=.env.local --import tsx scripts/seed/10-vocab.mts",
    "seed:tatoeba": "node --env-file-if-exists=.env.local --import tsx scripts/seed/20-tatoeba.mts",
    "seed:kaikki": "node --env-file-if-exists=.env.local --import tsx scripts/seed/30-kaikki-vi.mts",
    "seed:all": "node --env-file-if-exists=.env.local --import tsx scripts/seed/run-all.mts",
    "eval:chat": "node --env-file-if-exists=.env.local --import tsx evals/run-npc-chat.mts",
    "tts": "node --import tsx scripts/build-tts.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "obscenity": "^0.4.6",
    "posthog-js": "^1.438.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
