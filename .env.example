# Copy to .env.local. Values for local dev come from `pnpm db:start` output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude (content generation pipeline; see /admin/moderation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GEN=claude-sonnet-5-5
ANTHROPIC_MODEL_QA=claude-haiku-5-5
AI_DAILY_BUDGET_USD=15
# 1 = offline fake LLM (no API calls). Set to 0 with a real ANTHROPIC_API_KEY in production.
LLM_FAKE=1

# Cron routes require `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

APP_TIMEZONE=Asia/Ho_Chi_Minh
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
